# Copy this file to .env and fill in real local values.
# .env is gitignored - never commit real credentials.

# Database Configuration
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/beta_code"

# Redis Configuration
REDIS_URL="redis://127.0.0.1:6379"

# Worker Settings
JOBS_BASE="./runner/jobs"
CONCURRENCY=5

# Shared secret the runner uses to authenticate against the frontend's
# internal test-fetch API (must match the value passed to runner/worker.js).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNNER_SECRET=""
